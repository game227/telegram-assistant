# Telegram Bot API (BotFather orqali olinadi)
TELEGRAM_BOT_TOKEN=

# Telethon / MTProto (my.telegram.org saytidan, Faza 3 uchun kerak)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Anthropic Claude API
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# Botni faqat shu Telegram user id ga cheklaydi (owner)
OWNER_TELEGRAM_USER_ID=

# PostgreSQL ulanish manzili
DATABASE_URL=postgresql://neo:PASSWORD@localhost:5432/telegram_assistant

# Ixtiyoriy sozlamalar
SESSION_PATH=data/userbot
TIMEZONE=Asia/Tashkent
NEWS_DIGEST_HOUR=9
LOG_LEVEL=INFO
